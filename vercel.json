{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.jsx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/qr",
      "destination": "/Pagina%20Torneo.html",
      "permanent": false
    }
  ]
}
